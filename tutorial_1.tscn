[node name="Button2" type="Button" parent="." unique_id=1228808630]
offset_left = -222.00002
offset_top = -36.0
offset_right = 250.25871
offset_bottom = 87.0
scale = Vector2(0.70088696, 0.70088696)
text = "To treat the wound, you will need to apply a bandaid. Bandaids will prevent not only the wound but also the patient from getting worse along with healing said patient overtime."
alignment = 0
autowrap_mode = 2

[node name="Button3" type="Button" parent="." unique_id=1992034960]
offset_left = -205.0
offset_top = 58.000004
offset_right = 267.25873
offset_bottom = 198.12119
scale = Vector2(0.70088696, 0.70088696)
text = "Each level will have a time limit. that's how long you have to save the patient. At the same time, bandaids will deplete in effectiveness, visualized by how much blood is showing through. Bandaids on for too long will result in faster health depletion."
alignment = 0
autowrap_mode = 2
